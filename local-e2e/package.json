{
  "name": "pool-party-local-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Local two-fork development harness for the Pool Party v2 contracts: Arbitrum One and Robinhood Chain anvil forks, the real deployment scripts, a keeper standing in for Across relayers and Wormhole guardians, and an end-to-end scenario over JSON-RPC.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:harness": "tsx --test src/pending-transits.test.ts src/keeper-transits.test.ts src/conservation.test.ts src/spoke-report.test.ts",
    "check:recovery": "tsx scripts/check-recovery-scenario.ts",
    "test:alpha": "tsx --test src/alpha-relay.test.ts src/alpha-work.test.ts src/alpha-transactions.test.ts src/spoke-report.test.ts src/alpha-config.test.ts",
    "alpha:keeper": "tsx src/alpha.ts keeper",
    "alpha:api": "tsx src/alpha.ts api",
    "alpha:rehearsal": "tsx src/alpha-rehearsal.ts",
    "check:urls": "tsx scripts/check-url-redaction.ts",
    "check:lifecycle": "tsx scripts/check-lifecycle.ts",
    "typecheck": "tsc --noEmit",
    "up": "tsx src/up.ts",
    "down": "bash scripts/stop-forks.sh",
    "keeper": "tsx src/keeper.ts",
    "scenario": "tsx src/scenario.ts",
    "warp": "tsx src/warp.ts",
    "abis": "bash scripts/export-abis.sh",
    "status": "tsx src/status.ts",
    "api": "tsx src/api.ts",
    "api:probe": "tsx src/api-probe.ts"
  },
  "dependencies": {
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
