# Copy to .env. Never commit .env.
# Fork RPCs. Public endpoints work but are rate-limited; a provider key (Alchemy, QuickNode, dRPC) is
# recommended for the fork test suites.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Pin fork blocks for deterministic tests (leave empty to fork latest).
ARBITRUM_FORK_BLOCK=
ROBINHOOD_FORK_BLOCK=

# Deployment (mainnet or fork). Prefer `cast wallet` keystores over raw keys.
DEPLOYER_ADDRESS=
ARBISCAN_API_KEY=
