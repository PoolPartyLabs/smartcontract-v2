# Copy to .env. Never commit .env.
# Fork RPCs. Public endpoints work but are rate-limited; a provider key (Alchemy, QuickNode, dRPC) is
# recommended for the fork test suites.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Fork blocks: required by every fork suite (vm.envUint reverts when they are empty). Public RPCs serve recent
# state only (Robinhood about 10 minutes, Arbitrum about an hour), so set them to a recent block each session, e.g.
#   export ARBITRUM_FORK_BLOCK=$(( $(cast block-number --rpc-url $ARBITRUM_RPC_URL) - 300 ))
#   export ROBINHOOD_FORK_BLOCK=$(( $(cast block-number --rpc-url $ROBINHOOD_RPC_URL) - 300 ))
# or fix them once with an archive RPC.
ARBITRUM_FORK_BLOCK=
ROBINHOOD_FORK_BLOCK=

# Deployment (mainnet or fork). Prefer `cast wallet` keystores over raw keys.
DEPLOYER_ADDRESS=
ARBISCAN_API_KEY=

# script/DeployFactory.s.sol (required). API_SIGNER is the Pool Party API key: swap route signer of every fund
# (0x0000000000000000000000000000000000000000 for none) and owner of the hub ManagerRegistry (DEC-170 item 3):
# REGISTRY_OWNER defaults to API_SIGNER; uncomment it only to set another owner (an empty value is not "unset"),
# and set it when API_SIGNER is zero.
PROTOCOL_RECIPIENT=
ADAPTER_GUARDIAN=
API_SIGNER=
# REGISTRY_OWNER=

# script/CreateFund.s.sol (required; on Robinhood also CREATION_NUMBER and MANDATE_HASH from the hub's FundCreated)
FUND_FACTORY=
MANAGER=
CREATION_NUMBER=
MANDATE_HASH=
# Optional rule values (defaults shown; base units of 6 decimals, fees in bps)
SPOKE_CAP=10000000000
MIN_FIRST_DEPOSIT=100000000
PERFORMANCE_FEE_BPS=2000
MANAGEMENT_FEE_BPS=0
# Operating Cash is out of the MVP (ruling 2026-10-02): keep both at 0.
SPOKE_OPERATING_CASH_FLOOR=0
SPOKE_OPERATING_CASH_TOP_UP=0

# Optional first fund pool configuration (hookless, tokens in ascending address order).
HUB_POOL_TOKEN0=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
HUB_POOL_TOKEN1=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
HUB_POOL_FEE=500
HUB_POOL_TICK_SPACING=10
SPOKE_POOL_TOKEN0=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
SPOKE_POOL_TOKEN1=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
SPOKE_POOL_FEE=500
SPOKE_POOL_TICK_SPACING=10
HUB_AAVE_ASSET=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
SEED_AMOUNT=100000000
