    function _amounts() internal pure override returns (uint256, uint256, uint256, uint256) {
        return (1e18, 4000e6, 10_000e18, 50_000_000e6);
    }

    function _fund(address token, address to, uint256 amount) internal override {
        deal(token, to, amount);
    }
}
